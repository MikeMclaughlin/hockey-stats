{
  "headers": [
    {
      "source": "/(favicon.ico|favicon.svg|favicon-32x32.png|favicon-192x192.png|apple-touch-icon.png)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "functions": {
    "api/*.js": { "maxDuration": 60, "includeFiles": "{public,data}/**" },
    "server.js": { "maxDuration": 60, "includeFiles": "{public,data}/**" }
  },
  "crons": [
    { "path": "/api/cron", "schedule": "0 4 * * *" }
  ]
}
